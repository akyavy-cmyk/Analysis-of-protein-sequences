        "\n",
        "def comprehensive_protein_analysis(file_object):\n",
        "    \"\"\"Parses FASTA data and performs both basic and advanced sequence analyses.\"\"\"\n",
        "    # Parse records using Bio.SeqIO\n",
        "    records = list(SeqIO.parse(file_object, \"fasta\"))\n",
        "\n",
        "    if not records:\n",
        "        print(\"No protein records found.\")\n",
        "        return\n",
        "\n",
        "    print(f\"Total Proteins Loaded: {len(records)}\\n\")\n",
        "\n",
        "    # 1. Length Statistics & Advanced Biochemical Properties Table\n",
        "    print(\"=\" * 80)\n",
        "    print(f\"{'Header':<15} | {'Length':<6} | {'Mol. Weight':<12} | {'Isoelectric Pt':<15} | {'GRAVY'}\")\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "    all_sequences = \"\"\n",
        "    lengths = []\n",
        "\n",
        "    for record in records:\n",
        "        seq_str = str(record.seq).replace(\"*\", \"\")  # Clean sequence of stop codons\n",
        "        all_sequences += seq_str\n",
        "        seq_len = len(seq_str)\n",
        "        lengths.append((record.id, seq_len))\n",
        "\n",
        "        if seq_len > 0:\n",
        "            analysed = ProteinAnalysis(seq_str)\n",
        "            mol_weight = analysed.molecular_weight()\n",
        "            pi_val = analysed.isoelectric_point()\n",
        "            gravy_val = analysed.gravy()\n",
        "\n",
        "            print(f\"{record.id:<15} | {seq_len:<6} | {mol_weight:<12.2f} | {pi_val:<15.2f} | {gravy_val:.2f}\")\n",
        "\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "    # Sort lengths to find shortest/longest\n",
        "    lengths.sort(key=lambda x: x[1], reverse=True)\n",
        "    print(f\"\\nLongest Protein:  {lengths[0][0]} ({lengths[0][1]} aa)\")\n",
        "    print(f\"Shortest Protein: {lengths[-1][0]} ({lengths[-1][1]} aa)\")\n",
        "\n",
        "    # 2. Global Amino Acid Composition & Frequencies\n",
        "    aa_counts = Counter(all_sequences)\n",
        "    total_aas = len(all_sequences)\n",
        "\n",
        "    print(\"\\nGlobal Amino Acid Frequencies:\")\n",
        "    for aa, count in aa_counts.most_common():\n",
        "        percentage = (count / total_aas) * 100 if total_aas > 0 else 0\n",
        "        print(f\"  {aa}: {count} ({percentage:.2f}%)\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    # To run using a local FASTA file instead, uncomment the lines below:\n",
        "    # with open(\"proteins.fasta\", \"r\") as file_handle:\n",
        "    #     comprehensive_protein_analysis(file_handle)\n",
        "\n",
        "    # Running analysis on the sample data string\n",
        "    file_like_obj = StringIO(fasta_data.strip())\n",
        "    comprehensive_protein_analysis(file_like_obj)"
      ],
